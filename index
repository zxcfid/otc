<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>NFT Auto-Guarantor Mini App</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    :root {
      --bg: #0b0f19;
      --card: rgba(22, 29, 47, 0.85);
      --border: rgba(255, 255, 255, 0.08);
      --accent: #3b82f6;
      --accent-glow: rgba(59, 130, 246, 0.35);
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --text: #f8fafc;
      --muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background: radial-gradient(circle at top, #172554 0%, var(--bg) 55%); color: var(--text); min-height: 100vh; padding: 16px 16px 90px; }

    .glass-card {
      background: var(--card);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px;
      margin-bottom: 14px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
    }

    .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .brand { font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
    .support-chip {
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.4);
      color: #60a5fa;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      text-decoration: none;
    }

    .profile-hero { text-align: center; padding: 20px 16px; }
    .avatar-circle {
      width: 64px; height: 64px; border-radius: 50%;
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; font-weight: 700; margin: 0 auto 10px;
      box-shadow: 0 0 24px var(--accent-glow);
    }
    .balance-val { font-size: 28px; font-weight: 800; margin: 10px 0 4px; letter-spacing: -0.5px; }
    .currency-pills { display: flex; justify-content: center; gap: 8px; margin-top: 12px; }
    .curr-pill {
      padding: 6px 14px; border-radius: 10px; font-size: 12px; font-weight: 700;
      background: rgba(255,255,255,0.05); border: 1px solid var(--border); color: var(--muted); cursor: pointer;
    }
    .curr-pill.active { background: var(--accent); color: #fff; border-color: var(--accent); box-shadow: 0 0 12px var(--accent-glow); }

    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
    .stat-box { background: rgba(15, 23, 42, 0.7); border: 1px solid var(--border); border-radius: 14px; padding: 14px; text-align: center; }
    .stat-label { font-size: 12px; color: var(--muted); margin-bottom: 6px; }
    .stat-num { font-size: 18px; font-weight: 800; color: #fff; }

    .btn {
      width: 100%; padding: 13px; border-radius: 12px; border: none;
      font-size: 14px; font-weight: 700; cursor: pointer; transition: 0.2s;
      display: inline-flex; justify-content: center; align-items: center; gap: 8px;
    }
    .btn-primary { background: var(--accent); color: #fff; box-shadow: 0 4px 16px var(--accent-glow); }
    .btn-success { background: var(--success); color: #fff; }
    .btn-danger { background: rgba(239, 68, 68, 0.18); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.35); }
    .btn-outline { background: rgba(255,255,255,0.05); color: var(--text); border: 1px solid var(--border); }

    .input-group { margin-bottom: 12px; }
    .input-group label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; }
    .input-control {
      width: 100%; padding: 12px 14px; border-radius: 12px;
      background: rgba(15, 23, 42, 0.9); border: 1px solid var(--border);
      color: #fff; font-size: 14px; outline: none;
    }
    .input-control:focus { border-color: var(--accent); }

    .role-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 14px; }
    .role-btn {
      padding: 11px; border-radius: 12px; border: 1px solid var(--border);
      background: rgba(255,255,255,0.03); color: var(--muted); font-weight: 700; cursor: pointer;
    }
    .role-btn.active { background: rgba(59, 130, 246, 0.2); border-color: var(--accent); color: #fff; }

    .badge { padding: 4px 9px; border-radius: 8px; font-size: 11px; font-weight: 700; }
    .badge.pending { background: rgba(245, 158, 11, 0.18); color: #fbbf24; }
    .badge.funded { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
    .badge.completed { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .badge.cancelled { background: rgba(239, 68, 68, 0.18); color: #f87171; }

    .chat-box { height: 52vh; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding: 10px; background: rgba(11, 15, 25, 0.6); border-radius: 14px; margin-bottom: 10px; }
    .msg { max-width: 80%; padding: 10px 12px; border-radius: 14px; font-size: 13px; line-height: 1.4; }
    .msg.me { align-self: flex-end; background: var(--accent); color: #fff; border-bottom-right-radius: 4px; }
    .msg.other { align-self: flex-start; background: rgba(255,255,255,0.08); color: var(--text); border-bottom-left-radius: 4px; }
    .msg-author { font-size: 10px; opacity: 0.75; margin-bottom: 3px; font-weight: 700; }

    .bottom-nav {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(16px);
      border-top: 1px solid var(--border);
      display: grid; grid-template-columns: repeat(4, 1fr);
      padding: 8px 10px 18px; z-index: 100;
    }
    .nav-item {
      background: none; border: none; color: var(--muted);
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      font-size: 11px; font-weight: 600; cursor: pointer;
    }
    .nav-item.active { color: var(--accent); }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }
  </style>
</head>
<body>

  <div class="header-bar">
    <div class="brand">🛡 NFT Автогарант</div>
    <a href="https://t.me/ssupppoortt" target="_blank" class="support-chip">Саппорт: @ssupppoortt</a>
  </div>

  <!-- ВКЛАДКА 1: ПРОФИЛЬ -->
  <div id="tab-profile" class="tab-pane active">
    <div class="glass-card profile-hero">
      <div class="avatar-circle" id="prof-avatar">U</div>
      <div style="font-size:17px; font-weight:700;" id="prof-username">@username</div>
      <div style="font-size:12px; color:var(--muted); margin-top:2px;">Telegram ID: <span id="prof-id">0</span></div>

      <div class="balance-val" id="prof-balance">0.00 TON</div>
      <div style="font-size:12px; color:var(--muted);">Мультивалютный эскроу-кошелек</div>

      <div class="currency-pills">
        <button class="curr-pill" onclick="changeCurrency('TON')" id="curr-TON">TON</button>
        <button class="curr-pill" onclick="changeCurrency('USDT')" id="curr-USDT">USDT</button>
        <button class="curr-pill" onclick="changeCurrency('RUB')" id="curr-RUB">RUB</button>
        <button class="curr-pill" onclick="changeCurrency('UAH')" id="curr-UAH">UAH</button>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-box">
        <div class="stat-label">Количество сделок</div>
        <div class="stat-num" id="prof-deals-count">0</div>
      </div>
      <div class="stat-box">
        <div class="stat-label">Общий объем</div>
        <div class="stat-num" id="prof-volume">0.00 TON</div>
      </div>
    </div>

    <div class="glass-card">
      <div style="font-size:14px; font-weight:700; margin-bottom:10px;">Пополнение баланса</div>
      <div style="display:flex; gap:8px;">
        <input type="number" id="deposit-input" class="input-control" placeholder="Сумма в выбранной валюте" />
        <button class="btn btn-primary" style="width:auto; padding:0 20px;" onclick="depositBalance()">Пополнить</button>
      </div>
    </div>
  </div>

  <!-- ВКЛАДКА 2: МОИ СДЕЛКИ -->
  <div id="tab-deals" class="tab-pane">
    <div id="deals-list"></div>
  </div>

  <!-- ВКЛАДКА 3: СОЗДАТЬ СДЕЛКУ -->
  <div id="tab-create" class="tab-pane">
    <div class="glass-card">
      <div style="font-size:16px; font-weight:700; margin-bottom:12px;">💎 Новая безопасная сделка</div>
      <div class="role-switch">
        <button class="role-btn active" id="role-seller" onclick="setRole('seller')">📤 Я Продавец</button>
        <button class="role-btn" id="role-buyer" onclick="setRole('buyer')">📥 Я Покупатель</button>
      </div>

      <div class="input-group">
        <label>Второй участник (@username или Telegram ID)</label>
        <input type="text" id="deal-partner" class="input-control" placeholder="Например: @username или 123456789" />
      </div>

      <div class="input-group">
        <label>Название NFT / Цифрового товара</label>
        <input type="text" id="deal-nft-name" class="input-control" placeholder="Plush Pepe #412 / Telegram Gift" />
      </div>

      <div class="input-group">
        <label>Ссылка на NFT или описание</label>
        <input type="text" id="deal-nft-link" class="input-control" placeholder="https://t.me/nft/..." />
      </div>

      <div class="input-group">
        <label>Сумма сделки (<span id="create-curr-label">TON</span>)</label>
        <input type="number" id="deal-price" class="input-control" placeholder="100" />
      </div>

      <div style="font-size:12px; color:var(--muted); margin-bottom:12px; line-height:1.4;">
        ⚠️ Передача NFT осуществляется строго через аккаунт проверки <b>@ssupppoortt</b> после заморозки оплаты.
      </div>

      <button class="btn btn-primary" onclick="createDeal()">Создать сделку и пригласить</button>
    </div>
  </div>

  <!-- ВКЛАДКА 4: ЧАТ СДЕЛКИ -->
  <div id="tab-chat" class="tab-pane">
    <div class="glass-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
        <div style="font-size:14px; font-weight:700;" id="chat-title">Выберите сделку во вкладке «Сделки»</div>
      </div>
      <div class="chat-box" id="chat-messages"></div>
      <div style="display:flex; gap:8px;">
        <input type="text" id="chat-input" class="input-control" placeholder="Сообщение участнику..." />
        <button class="btn btn-primary" style="width:auto; padding:0 18px;" onclick="sendChatMessage()">➤</button>
      </div>
    </div>
  </div>

  <!-- НИЖНЯЯ НАВИГАЦИЯ -->
  <div class="bottom-nav">
    <button class="nav-item active" onclick="switchTab('profile')" id="nav-profile">👤<span>Профиль</span></button>
    <button class="nav-item" onclick="switchTab('deals')" id="nav-deals">📂<span>Сделки</span></button>
    <button class="nav-item" onclick="switchTab('create')" id="nav-create">➕<span>Создать</span></button>
    <button class="nav-item" onclick="switchTab('chat')" id="nav-chat">💬<span>Чат</span></button>
  </div>

  <script>
    const tg = window.Telegram.WebApp;
    tg.expand();

    const tgUser = tg.initDataUnsafe?.user || { id: 100001, username: "demo_user", first_name: "Demo" };
    let state = {
      user: { user_id: tgUser.id, username: tgUser.username || "", balance_usd: 0, deals_count: 0, total_volume_usd: 0, currency: "TON" },
      deals: [],
      rates: { USDT: 1.0, TON: 0.2, RUB: 95.0, UAH: 41.5 },
      role: "seller",
      activeChatDealId: null
    };

    function formatCurr(usd) {
      const curr = state.user.currency || "TON";
      const rate = state.rates[curr] || 1;
      return `${(usd * rate).toFixed(2)} ${curr}`;
    }

    function toUsd(val) {
      const curr = state.user.currency || "TON";
      const rate = state.rates[curr] || 1;
      return val / rate;
    }

    async function loadProfile() {
      const res = await fetch("/api/user", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ user_id: tgUser.id, username: tgUser.username || "" })
      });
      const data = await res.json();
      if (data.ok) {
        state.user = data.user;
        state.deals = data.deals;
        state.rates = data.rates;
        renderAll();
      }
    }

    function renderAll() {
      const u = state.user;
      document.getElementById("prof-avatar").innerText = (u.username || "U")[0].toUpperCase();
      document.getElementById("prof-username").innerText = u.username ? `@${u.username}` : "Без юзернейма";
      document.getElementById("prof-id").innerText = u.user_id;
      document.getElementById("prof-balance").innerText = formatCurr(u.balance_usd);
      document.getElementById("prof-deals-count").innerText = u.deals_count;
      document.getElementById("prof-volume").innerText = formatCurr(u.total_volume_usd);
      document.getElementById("create-curr-label").innerText = u.currency;

      ["TON", "USDT", "RUB", "UAH"].forEach(c => {
        document.getElementById(`curr-${c}`).classList.toggle("active", u.currency === c);
      });

      renderDeals();
    }

    function renderDeals() {
      const container = document.getElementById("deals-list");
      if (!state.deals.length) {
        container.innerHTML = `<div class="glass-card" style="text-align:center; color:var(--muted);">У вас пока нет сделок. Создайте первую во вкладке «Создать».</div>`;
        return;
      }

      const statusText = {
        pending: "Ожидает оплаты",
        funded: "Оплачена (Проверка @ssupppoortt)",
        completed: "Завершена",
        cancelled: "Отменена"
      };

      container.innerHTML = state.deals.map(d => {
        const isBuyer = d.buyer_id === state.user.user_id;
        let actions = `<button class="btn btn-outline" style="margin-top:8px;" onclick="openChat(${d.deal_id})">💬 Открыть чат сделки</button>`;

        if (d.status === "pending") {
          if (isBuyer) {
            actions = `<button class="btn btn-primary" onclick="dealAction(${d.deal_id}, 'pay')">💳 Оплатить (${formatCurr(d.price_usd)})</button>` + actions;
          }
          actions += `<button class="btn btn-danger" style="margin-top:8px;" onclick="dealAction(${d.deal_id}, 'cancel')">Отменить сделку</button>`;
        } else if (d.status === "funded") {
          if (isBuyer) {
            actions = `<button class="btn btn-success" onclick="dealAction(${d.deal_id}, 'complete')">✅ Товар получен от @ssupppoortt</button>` + actions;
          }
        }

        return `
          <div class="glass-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
              <b>Сделка #${d.deal_id} — ${d.nft_name}</b>
              <span class="badge ${d.status}">${statusText[d.status] || d.status}</span>
            </div>
            <div style="font-size:12px; color:var(--muted); margin-bottom:4px;">Ссылка: ${d.nft_link || "—"}</div>
            <div style="font-size:12px; color:var(--muted); margin-bottom:8px;">
              Продавец ID: <code>${d.seller_id}</code> | Покупатель ID: <code>${d.buyer_id}</code>
            </div>
            <div style="font-size:16px; font-weight:800; margin-bottom:10px;">Сумма: ${formatCurr(d.price_usd)}</div>
            ${actions}
          </div>
        `;
      }).join("");
    }

    async function changeCurrency(curr) {
      const res = await fetch("/api/currency", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ user_id: state.user.user_id, currency: curr })
      });
      const data = await res.json();
      if (data.ok) {
        state.user = data.user;
        renderAll();
      }
    }

    async function depositBalance() {
      const val = parseFloat(document.getElementById("deposit-input").value);
      if (!val || val <= 0) return alert("Введите корректную сумму");
      const res = await fetch("/api/deposit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ user_id: state.user.user_id, amount_usd: toUsd(val) })
      });
      const data = await res.json();
      if (data.ok) {
        document.getElementById("deposit-input").value = "";
        state.user = data.user;
        renderAll();
      }
    }

    function setRole(role) {
      state.role = role;
      document.getElementById("role-seller").classList.toggle("active", role === "seller");
      document.getElementById("role-buyer").classList.toggle("active", role === "buyer");
    }

    async function createDeal() {
      const partner = document.getElementById("deal-partner").value.trim();
      const nft_name = document.getElementById("deal-nft-name").value.trim();
      const nft_link = document.getElementById("deal-nft-link").value.trim();
      const priceVal = parseFloat(document.getElementById("deal-price").value);

      if (!partner || !nft_name || !priceVal || priceVal <= 0) {
        return alert("Заполните участника, название NFT и сумму сделки");
      }

      const res = await fetch("/api/deals/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          creator_id: state.user.user_id,
          role: state.role,
          partner,
          nft_name,
          nft_link,
          price_usd: toUsd(priceVal)
        })
      });
      const data = await res.json();
      if (!data.ok) return alert(data.error);

      state.deals = data.deals;
      renderAll();
      switchTab("deals");
    }

    async function dealAction(deal_id, action) {
      const res = await fetch("/api/deals/action", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ user_id: state.user.user_id, deal_id, action })
      });
      const data = await res.json();
      if (!data.ok) return alert(data.error);
      state.user = data.user;
      state.deals = data.deals;
      renderAll();
    }

    async function openChat(dealId) {
      state.activeChatDealId = dealId;
      switchTab("chat");
      await fetchChat();
    }

    async function fetchChat() {
      if (!state.activeChatDealId) return;
      const res = await fetch(`/api/chat/${state.activeChatDealId}`);
      const data = await res.json();
      if (!data.ok) return;

      document.getElementById("chat-title").innerText = `Чат сделки #${data.deal.deal_id} (${data.deal.nft_name})`;
      const box = document.getElementById("chat-messages");
      box.innerHTML = data.messages.map(m => {
        const isMe = m.sender_id === state.user.user_id;
        return `
          <div class="msg ${isMe ? 'me' : 'other'}">
            <div class="msg-author">${m.sender_name}</div>
            <div>${m.message_text}</div>
          </div>
        `;
      }).join("");
      box.scrollTop = box.scrollHeight;
    }

    async function sendChatMessage() {
      if (!state.activeChatDealId) return alert("Сначала выберите сделку во вкладке «Сделки»");
      const input = document.getElementById("chat-input");
      const text = input.value.trim();
      if (!text) return;

      input.value = "";
      await fetch("/api/chat/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          deal_id: state.activeChatDealId,
          sender_id: state.user.user_id,
          sender_name: state.user.username ? `@${state.user.username}` : `ID ${state.user.user_id}`,
          text
        })
      });
      await fetchChat();
    }

    function switchTab(tab) {
      ["profile", "deals", "create", "chat"].forEach(t => {
        document.getElementById(`tab-${t}`).classList.toggle("active", t === tab);
        document.getElementById(`nav-${t}`).classList.toggle("active", t === tab);
      });
    }

    setInterval(() => {
      if (document.getElementById("tab-chat").classList.contains("active") && state.activeChatDealId) {
        fetchChat();
      }
    }, 3000);

    loadProfile();
  </script>
</body>
</html>
